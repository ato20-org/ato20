{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ato20",
  "version": "0.1.0",
  "identifier": "show.rpg.ato20",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm clean:web-resources && pnpm dev",
    "beforeBuildCommand": "pnpm clean:web-resources && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ATO20",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "url": "/operador"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../out": "out"
    }
  }
}
