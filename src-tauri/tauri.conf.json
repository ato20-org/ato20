{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ato20",
  "version": "0.0.5",
  "identifier": "show.rpg.ato20",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm clean:web-resources && pnpm pdfjs && pnpm garantir-out && pnpm dev",
    "beforeBuildCommand": "pnpm clean:web-resources && pnpm pdfjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ATO20",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "url": "/",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "RolePlayingGame",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "resources": {
      "../out": "out"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ato20-org/desktop.ato20/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRDRCQ0IzMTk4NkRGQkYKUldTLzM0WVpzN3pVc1R5TFVUcnZEa3RBQWpXYlM1Wk13NThHUEowOTJiUnhSb2FqWVpBdlBWdUEK"
    }
  }
}
