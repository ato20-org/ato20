# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# o exemplo e documentacao: precisa ir para o repositorio
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# o runtime do pdf.js, copiado de node_modules por scripts/copiar-pdfjs.mjs
/public/pdfjs/

# Worktrees de git, que moram DENTRO do repositorio para o build isolado nao
# competir com o `tauri dev` aberto no tree principal. O conteudo e uma copia
# de trabalho, nao fonte. O `eslint.config.mjs` ignora `.claude/**` pela mesma
# razao, e la e mais largo: o `.next/` de um worktree rendia 36 mil avisos.
/.claude/worktrees/
